---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "MyRigFoundry — PC Problems, Explained",
  description = "Step-by-step PC troubleshooting guides, hardware explanations and upgrade advice.",
  canonical,
  image,
  imageAlt = "MyRigFoundry PC troubleshooting and hardware guides",
  type = "website",
  noindex = false,
} = Astro.props;

const automaticCanonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;

const canonicalUrl =
  canonical || automaticCanonical;

const absoluteImage =
  image && Astro.site
    ? new URL(image, Astro.site).toString()
    : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#07111f"
    />

    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="icon"
      href="/favicon.ico"
    />

    {
      canonicalUrl && (
        <link
          rel="canonical"
          href={canonicalUrl}
        />
      )
    }

    <meta
      property="og:site_name"
      content="MyRigFoundry"
    />

    <meta
      property="og:locale"
      content="en_US"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:type"
      content={type}
    />

    {
      canonicalUrl && (
        <meta
          property="og:url"
          content={canonicalUrl}
        />
      )
    }

    {
      absoluteImage && (
        <>
          <meta
            property="og:image"
            content={absoluteImage}
          />

          <meta
            property="og:image:alt"
            content={imageAlt}
          />
        </>
      )
    }

    <meta
      name="twitter:card"
      content={
        absoluteImage
          ? "summary_large_image"
          : "summary"
      }
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    {
      absoluteImage && (
        <>
          <meta
            name="twitter:image"
            content={absoluteImage}
          />

          <meta
            name="twitter:image:alt"
            content={imageAlt}
          />
        </>
      )
    }

    <slot name="head" />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>